# ══════════════════════════════════════════════════════════════════
#   CLIPPING AUTOMATION — ENVIRONMENT VARIABLES
#   Copy this file to .env and fill in your values.
#   Never commit your .env file to git.
# ══════════════════════════════════════════════════════════════════


# ── Telegram Bot ──────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram user ID (the bot will only respond to you)
# Get it by messaging @userinfobot on Telegram
TELEGRAM_USER_ID=your_telegram_user_id_here


# ── Google Gemini API (free tier) ─────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (flash is free and fast)
GEMINI_MODEL=gemini-1.5-flash


# ── YouTube Data API v3 ───────────────────────────────────────────
# Get from: https://console.cloud.google.com
# Enable "YouTube Data API v3" in your project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Path to OAuth2 credentials JSON (for uploading to YOUR YouTube channel)
# Download from Google Cloud Console → Credentials → OAuth 2.0 Client
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json


# ── Instagram Graph API ───────────────────────────────────────────
# Get from: https://developers.facebook.com
# Requires a Professional (Creator/Business) Instagram account
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here


# ── Whisper Transcription ─────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v2
# tiny/base = fast but less accurate | large-v2 = slow but best accuracy
# Recommended: "small" for a good balance on most laptops
WHISPER_MODEL=small

# Device to run Whisper on: "cpu" or "cuda" (cuda = Nvidia GPU, much faster)
WHISPER_DEVICE=cpu


# ── Clip Settings ─────────────────────────────────────────────────
# Default min/max clip length in seconds
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=90

# Number of clips to generate per video
CLIPS_PER_VIDEO=5

# Default output format: vertical (9:16 Reels/Shorts)
# Horizontal clips are only made when explicitly requested via Telegram
DEFAULT_FORMATS=vertical


# ── Storage Paths ─────────────────────────────────────────────────
DOWNLOADS_DIR=output/downloads
CLIPS_DIR=output/clips
LOGS_DIR=output/logs


# ── Channel Monitor ───────────────────────────────────────────────
# How often to check channels for new videos (in minutes)
MONITOR_INTERVAL_MINUTES=15
